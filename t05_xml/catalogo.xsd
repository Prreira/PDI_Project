<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://ispgaya.pt/pi/bibliopi"
           xmlns="http://ispgaya.pt/pi/bibliopi"
           xmlns:b="http://ispgaya.pt/pi/bibliopi"
           xmlns:dc="http://purl.org/dc/elements/1.1/"
           xmlns:adm="http://ispgaya.pt/pi/bibliopi/adm"
           elementFormDefault="qualified">

  <xs:import namespace="http://purl.org/dc/elements/1.1/" schemaLocation="dc_subset.xsd"/>
  <xs:import namespace="http://ispgaya.pt/pi/bibliopi/adm" schemaLocation="adm.xsd"/>

  <xs:simpleType name="TipoIdDocumento">
    <xs:restriction base="xs:string">
      <xs:pattern value="DOC-\d{4}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoISBN13">
    <xs:restriction base="xs:string">
      <xs:pattern value="978-\d{10}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoDOI">
    <xs:restriction base="xs:string">
      <xs:pattern value="10\.\d{4,9}/[A-Za-z0-9._-]+"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoCDU">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{3}(\.\d{1,3})?"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AnoPublicacao">
    <xs:restriction base="xs:gYear">
      <xs:minInclusive value="1900"/>
      <xs:maxInclusive value="2026"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoPalavraChave">
    <xs:restriction base="xs:string">
      <xs:minLength value="2"/>
      <xs:maxLength value="50"/>
      <xs:whiteSpace value="collapse"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoFormatoMultimedia">
    <xs:restriction base="xs:string">
      <xs:enumeration value="video"/>
      <xs:enumeration value="audio"/>
      <xs:enumeration value="podcast"/>
      <xs:enumeration value="documentario"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TipoDuracaoMinutos">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="5"/>
      <xs:fractionDigits value="1"/>
      <xs:minInclusive value="0.5"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="TipoResumo" mixed="true">
    <xs:sequence>
      <xs:element name="termo" type="TipoPalavraChave" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TipoLivro">
    <xs:sequence>
      <xs:element name="isbn" type="TipoISBN13"/>
      <xs:element name="editora" type="xs:string"/>
      <xs:element name="paginas" type="xs:integer"/>
    </xs:sequence>
    <xs:attribute name="edicao" type="xs:integer" use="optional" default="1"/>
  </xs:complexType>

  <xs:complexType name="TipoArtigo">
    <xs:sequence>
      <xs:element name="doi" type="TipoDOI"/>
      <xs:element name="revista" type="xs:string"/>
      <xs:element name="volume" type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TipoTese">
    <xs:sequence>
      <xs:element name="instituicao" type="xs:string"/>
      <xs:element name="grau" type="xs:string"/>
      <xs:element name="orientador" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TipoMultimedia">
    <xs:sequence>
      <xs:element name="formato" type="TipoFormatoMultimedia"/>
      <xs:element name="duracaoMin" type="TipoDuracaoMinutos"/>
      <xs:element name="plataforma" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="TipoDocumento">
    <xs:sequence>
      <xs:element ref="dc:title"/>
      <xs:element ref="dc:creator" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element ref="dc:subject" minOccurs="1" maxOccurs="unbounded"/>
      <xs:element ref="dc:description"/>
      <xs:element ref="dc:date"/>
      <xs:element ref="dc:language"/>
      <xs:element name="cdu" type="TipoCDU"/>
      <xs:element name="anoPublicacao" type="AnoPublicacao"/>
      <xs:element name="resumo" type="TipoResumo"/>
      <xs:choice>
        <xs:element name="livro" type="TipoLivro"/>
        <xs:element name="artigo" type="TipoArtigo"/>
        <xs:element name="tese" type="TipoTese"/>
        <xs:element name="multimedia" type="TipoMultimedia"/>
      </xs:choice>
      <xs:element name="relacionados" minOccurs="0">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="relacionado" minOccurs="1" maxOccurs="unbounded">
              <xs:complexType>
                <xs:attribute name="ref" type="TipoIdDocumento" use="required"/>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element ref="adm:metadados"/>
    </xs:sequence>
    <xs:attribute name="id" type="TipoIdDocumento" use="required"/>
  </xs:complexType>

  <!-- Elemento raiz -->
  <xs:element name="catalogo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="documento" type="TipoDocumento" minOccurs="1" maxOccurs="unbounded"/>
      </xs:sequence>
      <xs:attribute name="repositorio" type="xs:string" fixed="BiblioPI"/>
      <xs:attribute name="subtema" type="xs:string" use="required"/>
      <xs:attribute name="versao" type="xs:string" use="optional" default="1.0"/>
    </xs:complexType>

    <xs:key name="chaveDocumento">
      <xs:selector xpath="b:documento"/>
      <xs:field xpath="@id"/>
    </xs:key>

    <xs:keyref name="refDocumentoRelacionado" refer="b:chaveDocumento">
      <xs:selector xpath="b:documento/b:relacionados/b:relacionado"/>
      <xs:field xpath="@ref"/>
    </xs:keyref>
  </xs:element>

</xs:schema>